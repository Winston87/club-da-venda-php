# Nunca publique o arquivo .env com dados reais.
# Use a string de conexão PostgreSQL do Supabase (Pooler ou conexão direta).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"

# URL usada ao criar links e cookies em produção.
APP_URL="http://localhost:8080"
APP_ENV="local"
APP_SESSION_NAME="club_da_venda_php"

# Defina o slug da loja enquanto a versão PHP ainda estiver em teste local.
DEFAULT_STORE_SLUG="lm-store-615d02ee"
